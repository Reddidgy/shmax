# Port the Flask API listens on (default: 4748)
FEEDBACK_API_PORT=4748

# Path to the SQLite database file (default: feedback.db in the feedback_api directory)
FEEDBACK_DB_PATH=feedback.db

# Secret token required by developer clients to access GET /get_feedback.
# Keep this secret. Requests must include: X-Dev-Token: <value>
DEV_TOKEN=change-me-to-a-strong-random-secret
# IMPORTANT: DEV_TOKEN is REQUIRED for production. When empty or unset,
# all dev endpoints (/get_feedback, /resolve_feedback, /get_metrics) return 403.

# Set to "true" to enable Flask debug mode (development only)
FLASK_DEBUG=false

# Bind address for the API server (default: 127.0.0.1 — loopback only).
# Set to 0.0.0.0 only when explicitly needed (e.g., behind a reverse proxy in Docker).
HOST=127.0.0.1

# Rate limiting configuration for POST /submit_feedback
RATE_LIMIT_SECONDS=120
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# CORS Configuration (OWASP API7:2023 Compliance)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS requests.
# Production: Set this to your deployed frontend origin(s).
# Development: Defaults to localhost origins if not set.
#
# Example (production):
#   CORS_ALLOWED_ORIGINS=https://praxisos.dev
#
# Example (multiple origins):
#   CORS_ALLOWED_ORIGINS=https://praxisos.dev,https://staging.praxis.sytes.net
#
# Example (development with custom port):
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://praxisos.dev

# ---------------------------------------------------------------------------
# Visitor Tracking (User Metrics)
# ---------------------------------------------------------------------------
# Salt for visitor hash (privacy-preserving unique user approximation).
# Change this to invalidate all historical hashes if needed.
VISITOR_SALT=change-me-to-a-random-string

# Rate limit for /track endpoint (seconds between calls per IP)
TRACK_RATE_LIMIT_SECONDS=10

# Enable dynamic localhost origin matching (development only).
# When set to "true", any localhost/127.0.0.1 origin is allowed.
# WARNING: Do not enable in production.
CORS_ALLOW_LOCALHOST_DYNAMIC=false

# ===========================================================================
# Praxis Local API (praxis_local_api.py)  -  LOCAL ONLY
# ===========================================================================
# A separate local process from the feedback API above. It binds to 127.0.0.1
# (loopback only) and wraps the user's locally installed `claude` CLI.
#
# EXTERNAL RUNTIME DEPENDENCY (not pip-installable): the `claude` CLI must be
# installed and authenticated (`npm install -g @anthropic-ai/claude-code`,
# then `claude login`). The Praxis Local API only discovers it on PATH (or via
# CHAT_CLAUDE_BIN below); it never installs or manages it.

# Port the Praxis Local API listens on (default: 7865; avoids Vite 5173 and the
# feedback API's 4748). The legacy CHAT_API_PORT is deprecated but still read as
# a fallback when LOCAL_API_PORT is unset.
LOCAL_API_PORT=7865

# Default Claude model alias used when a chat request omits `model`.
# Use an alias (haiku|sonnet|opus) or a full model ID `claude --model` accepts.
DEFAULT_MODEL=sonnet

# Comma-separated allowed CORS origins for the Praxis Local API routes.
# LEAVE UNSET (default): any loopback origin  -  http(s)://localhost|127.0.0.1|[::1]
# on ANY port  -  plus https://praxisos.dev is allowed. This is safe because the
# API binds the loopback interface only (unreachable off-host) and handles no
# credentials/secrets. Set this ONLY to pin an explicit allowlist, which then
# fully replaces the permissive-loopback default. The legacy CHAT_CORS_ORIGINS
# is deprecated but still read as a fallback when LOCAL_API_CORS_ORIGINS is unset.
# LOCAL_API_CORS_ORIGINS=http://localhost:5173,https://praxisos.dev

# Minimum seconds between chat requests per session (used by /api/chat).
CHAT_RATE_LIMIT_SECONDS=5

# Optional explicit path to the `claude` binary. Leave unset to resolve via
# PATH (shutil.which). Set this if the API process's PATH differs from your
# interactive shell, to avoid a false "claude missing" state.
# CHAT_CLAUDE_BIN=/Users/you/.local/bin/claude

# Working directory the spawned `claude` process runs in. Leave unset to use the
# project root (the parent of this api/ directory, derived from the script
# location) so chat has project context regardless of where you launch the
# server. Set only to point claude at a different directory.
# CHAT_PROJECT_ROOT=/path/to/your/project

# FLASK_DEBUG is shared with the feedback API block above (set to "true" only
# for local development).
