# Database
DATABASE_URL=postgresql+asyncpg://messenger:messenger@localhost:5432/messenger

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-in-production-use-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# S3 / Object Storage
S3_BUCKET_NAME=messenger-media
S3_ENDPOINT_URL=https://s3.amazonaws.com
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# CORS
CORS_ORIGINS=["http://localhost:19006", "http://localhost:8081", "http://localhost:3000"]
# LAN origins (192.168.x.x) are allowed by default via allow_origin_regex in main.py

# --- Production (VPS repo-root .env; see DEPLOY.md) ---
# HOST=127.0.0.1
# PORT=8100
# ROOT_PATH=/shmax/api
# POSTGRES_USER=messenger
# POSTGRES_PASSWORD=<strong-random-password>
# POSTGRES_DB=messenger
# DATABASE_URL=postgresql+asyncpg://messenger:<strong-random-password>@127.0.0.1:5432/messenger
# REDIS_URL=redis://127.0.0.1:6379/0
# SECRET_KEY=<48+ random hex chars>
# NOTE: this file is sourced by the shell, so JSON values MUST be single-quoted:
# CORS_ORIGINS='["https://raskolniktv.mooo.com"]'
